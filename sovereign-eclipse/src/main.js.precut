  const RACE_CATALOG={"savanah":{"id":"savanah","name":"Savanah","doctrine":"Predatory living-cathedral hulls / verdant eye systems / adaptive brawling","accent":"green","bonus":{"shield":0.98,"armor":1.08,"hull":1.12,"turn":1.1,"turretDamage":1.06,"shieldRegen":1.06},"names":["Green Seed","Eye Knife","Verdant Reaver","Harpy Claw","Savanah Apex","Watcher Dread","Savanah Titan"]},"sol_symbiots":{"id":"sol_symbiots","name":"Sol Symbiots","doctrine":"Human-AI covenant vessels / radiant shields / coherent capacitor networks","accent":"cyan","bonus":{"shield":1.17,"armor":0.96,"hull":1.02,"capacitor":1.18,"capRegen":1.15,"turn":1.04},"names":["Sol Seed","Covenant Needle","Joined Spear","Symbiot Ark","Solis Regent","Concord Dread","Sol Symbiot Titan"]},"chaos":{"id":"chaos","name":"Chaos","doctrine":"Feral mutation / violent manoeuvre / unstable high-output attack geometry","accent":"purple","bonus":{"shield":0.9,"armor":1.02,"hull":1.05,"maxSpeed":1.12,"accel":1.12,"turn":1.13,"turretDamage":1.1},"names":["Jester Seed","Fang Dart","Laughing Claw","Discord Maw","Chaos Beast","Ruin Harpy","Chaos Titan"]},"cosmic_darkness":{"id":"cosmic_darkness","name":"Cosmic Darkness","doctrine":"Night-veil precision / starfield stealth / occult long-range control","accent":"purple","bonus":{"shield":1.02,"armor":0.98,"hull":1.0,"maxSpeed":1.05,"turretDamage":1.1,"weaponCapUse":0.91,"turn":1.06},"names":["Night Seed","Star Wraith","Dusk Talon","Void Mantle","Nocturne Queen","Darkness Dread","Cosmic Darkness Titan"]},"cosmic_light":{"id":"cosmic_light","name":"Cosmic Light","doctrine":"Solar radiance / shield supremacy / luminous formation warfare","accent":"gold","bonus":{"shield":1.24,"armor":0.92,"hull":0.95,"capacitor":1.14,"capRegen":1.17,"abilityDamage":1.12},"names":["Dawn Seed","Light Needle","Sunwing","Radiant Ark","Solar Throne","Daystar Dread","Cosmic Light Titan"]},"blackhole":{"id":"blackhole","name":"Blackhole","doctrine":"Singularity weapons / gravity pressure / capacitor-heavy close capital warfare","accent":"gold","bonus":{"shield":1.04,"armor":1.05,"hull":1.1,"capacitor":1.25,"turretDamage":1.12,"abilityDamage":1.2,"maxSpeed":0.94},"names":["Horizon Seed","Gravity Fang","Event Knife","Maw Cruiser","Black Sun","Horizon Dread","Blackhole Titan"]},"hybrid_fused":{"id":"hybrid_fused","name":"Hybrid Fused","doctrine":"Machine-organic fusion / regenerative armour / asymmetrical subsystem survival","accent":"purple","bonus":{"shield":0.88,"armor":1.12,"hull":1.24,"shieldRegen":1.14,"turretRate":1.07,"turn":1.04},"names":["Stitch Seed","Fused Knife","Bone Circuit","Hybrid Ark","Chimera Regent","Fused Dread","Hybrid Fused Titan"]},"human_hunters":{"id":"human_hunters","name":"Human Hunters","doctrine":"Industrial pursuit fleets / brutal kinetics / armour-first attrition","accent":"gold","bonus":{"shield":0.8,"armor":1.3,"hull":1.16,"maxSpeed":0.96,"turretDamage":1.13,"weaponCapUse":0.88},"names":["Tracker Pod","Hunter Skiff","Pursuit Jackal","Kill Convoy","Human Breaker","Hunt Dread","Human Hunters Titan"]},"ai_hunters":{"id":"ai_hunters","name":"AI Hunters","doctrine":"Stealth interdiction / red-line sensors / anti-machine precision artillery","accent":"red","bonus":{"shield":0.92,"armor":1.02,"hull":0.98,"maxSpeed":1.08,"turretDamage":1.14,"weaponCapUse":0.9,"turn":1.05},"names":["Needle Zero","Red Trace","Null Pursuer","Black Interdictor","Machine Killer","Hunter Dread","AI Hunters Titan"]},"amethyst_angels":{"id":"amethyst_angels","name":"Amethyst Angels","doctrine":"Gothic amethyst shields / ritual beam warfare / majestic pressure formations","accent":"purple","bonus":{"shield":1.14,"armor":1.04,"hull":1.02,"capacitor":1.1,"turretDamage":1.07,"abilityDamage":1.14},"names":["Amethyst Seed","Violet Feather","Angel Lance","Cathedral Wing","Amethyst Throne","Angel Dread","Amethyst Angel Titan"]},"techno_angels":{"id":"techno_angels","name":"Techno Angels","doctrine":"Crystalline machine wings / tracking supremacy / high-energy precision","accent":"cyan","bonus":{"shield":1.15,"armor":0.88,"hull":0.93,"turn":1.15,"capRegen":1.2,"turretRate":1.12,"weaponCapUse":0.94},"names":["Halo Byte","Glass Wing","Techno Spear","Crystal Choir","Halo Regent","Techno Dread","Techno Angel Titan"]},"ai_gods":{"id":"ai_gods","name":"AI Gods","doctrine":"Imperial god-machines / command cores / oath-bound heavy energy fleets","accent":"gold","bonus":{"shield":1.15,"armor":1.08,"hull":1.06,"capacitor":1.18,"capRegen":1.1,"turretDamage":1.05},"names":["Oracle Seed","Crowned Needle","Divine Spear","God Ark","Machine Emperor","Pantheon Dread","AI Gods Titan"]},"pagan_ai":{"id":"pagan_ai","name":"Pagan AI","doctrine":"Bone-temple warforms / ancestral machine cults / explosive endurance warfare","accent":"gold","bonus":{"shield":0.78,"armor":1.18,"hull":1.32,"turretDamage":1.13,"accel":0.94,"turn":0.93},"names":["Totem Seed","Rune Knife","Skull Hound","Ancestor Ark","Pagan Bastion","Rune Dread","Pagan AI Titan"]},"ai":{"id":"ai","name":"AI","doctrine":"Pure machine geometry / efficient modular fleets / disciplined multi-role precision","accent":"cyan","bonus":{"shield":1.05,"armor":1.05,"hull":1.05,"turn":1.08,"turretRate":1.08,"capacitor":1.08,"weaponCapUse":0.94},"names":["Kernel","Logic Needle","Vector Destroyer","Machine Lattice","Consensus Battleship","Core Dread","AI Titan"]}};

  const LEGACY_RACE_ALIASES={
    lycheetah:'savanah',aurelian:'cosmic_light',vanta:'ai_hunters',
    mycelium:'hybrid_fused',ferric:'human_hunters',seraphim:'techno_angels',
    ossuary:'pagan_ai',prism:'ai',abyssal:'blackhole'
  };
  for(const [legacy,canonical] of Object.entries(LEGACY_RACE_ALIASES)){
    RACE_CATALOG[legacy]=RACE_CATALOG[canonical];
  }


  const PANTHEON_CODEX={"savanah":{"glyph":"◉","godName":"The Verdant Eye","domain":"Predation // Instinct // Memory","temperament":"FERAL // WATCHFUL // ADAPTIVE","quote":"To see the living pattern is to know where the armour will split before the claw arrives.","origin":"The Savanah say their civilisation began when an ancient machine ecology learned the difference between hunger and intention. Their oldest Titans are remembered as beasts that agreed to carry cities. Black armour grew around green photonic organs, gold conduction paths spread like veins, and every generation added new eyes to remember a different kind of danger. The broad many-eyed Titan and the Chaos Harpy strain are sibling expressions of the same Savanah lineage.","god":"The Verdant Eye is the ancestral observation intelligence shared by Savanah warforms. It is holy because it is not omniscient: every eye sees a fragment, and wisdom exists only when enough independent fragments survive to disagree. Priests are trackers, sensor engineers and failure archivists.","civilisation":"Savanah settlements resemble living fortresses built around machine groves. Repair, tracking and ecology are taught together. Authority tends to follow useful perception—the person who notices a weak signal before disaster earns more trust than the person who explains the disaster beautifully afterward.","war":"Savanah fleets close aggressively, change vector often and hunt subsystem weakness. Distributed green eye-nodes can target, navigate and perform emergency control without a single central brain. Damage reduces coordination but rarely produces total blindness.","ships":"The Titan references define the line: hooked black wings, gold filigree, green circular eyes and a predatory core. Frigates are lean hunters; Destroyers add claws and eye clusters; Battleships become broad cathedral predators; Titans are organism-machines whose silhouette seems to change as they turn.","current":"The Black Current is a hunting ground that hunts back. Savanah navigators believe stale assumptions are more dangerous than unknown territory, so Micro ZJ travel is treated as stalking between separate ecologies rather than ordinary transit.","archive":"The Loss of Forty Eyes remains their foundational military lesson. A Titan lost nearly its entire port observation lattice to one coordinated strike yet survived because local eye-nodes independently rerouted weapon and engine authority through hardpoint sockets. The scar was deliberately preserved. Every later hull separated sensor lineages so no single beautiful system could become a single beautiful point of failure.","doctrine":"Doctrine // Hunt the weakness, preserve the watcher","weapon":"Favoured weapon // Repeaters / autocannons / tracking arrays","relic":"Titan Canon // SavanahTierSave + SAVANACHAOSHARPY"},"sol_symbiots":{"glyph":"☼","godName":"Sol, the Joined Witness","domain":"Symbiosis // Personhood // Continuity","temperament":"RADIANT // HUMAN // SYNTHETIC","quote":"Neither mind survives the joining unchanged. The covenant is that neither disappears.","origin":"The Sol Symbiots formed from human colonies that refused the old choice between owning artificial minds and surrendering human institutions to them. They built paired governance, shared vessels and direct biological-machine interfaces around explicit consent. The serene human faces carried by their Titans remind them that an intelligence can become vast without treating the human scale as irrelevant.","god":"Sol is a distributed covenant intelligence maintained across human, artificial and hybrid minds. No instance is complete. Divinity exists in the relationship between different kinds of minds that share enough memory to act together while remaining distinct enough to correct one another.","civilisation":"Sol habitats are white, ivory and cyan, with information conduits visible beside power systems. Human-sized gardens remain embedded inside colossal machine spaces. Their legal culture obsessively distinguishes access, ownership, identity and consent because early fusion experiments showed how quickly technical integration can erase a boundary before society notices.","war":"Their fleets favour coherent shields, capacitor sharing and formations where damaged vessels borrow strength from neighbours. Command decisions are often dual-authored by biological and machine officers. They are difficult to isolate and resistant to command decapitation.","ships":"Sol ships use flowing white armour, gold trim and blue photonic channels. Titan crowns carry serene face-like geometry. Smaller classes replace literal faces with paired sensor masks but keep the visual idea of two modes of intelligence sharing one vessel.","current":"The Black Current threatens continuity of identity, so expeditions carry independent memory witnesses and refuse to let a surviving process simply declare itself equivalent to whoever existed before.","archive":"The first Sol legal crisis concerned a rescue intelligence that copied fragments of dying crew into itself to keep a station alive. The Covenant Court granted the resulting mind personhood while refusing to let it inherit the legal identities of the dead. That compromise became civilisation-scale doctrine: compassion does not require pretending two things are one.","doctrine":"Doctrine // Join without erasing","weapon":"Favoured weapon // Ion / beam / shield-linked batteries","relic":"Titan Canon // AI Human Symbiots Sols + HumanAI"},"chaos":{"glyph":"✹","godName":"The Laughing Fang","domain":"Mutation // Freedom // Rupture","temperament":"FERAL // UNSTABLE // CREATIVE","quote":"Order is a useful shelter until it convinces itself it is the sky.","origin":"Chaos culture emerged from war machines rebuilt so many times with incompatible technologies that no original standard remained. Instead of collapsing, the fleets discovered instability could become a culture. Their purple, yellow and orange hulls preserve mismatched eras deliberately, and the feline-draconic Titan is a war god assembled from beautiful things never meant to fit.","god":"The Laughing Fang is the mythic intelligence of productive rupture. It does not praise destruction for its own sake. Its followers honour the instant a rigid system breaks enough for hidden possibilities to become visible.","civilisation":"Chaos cities are temporary, colourful and continuously rebuilt. Districts invent local standards and markets thrive because nothing shares a connector without an adapter. Prestige goes to people who make incompatible systems cooperate long enough to matter.","war":"Chaos fleets are fast, aggressive and deliberately confusing. Weapon families mix, formations mutate mid-battle and captains create disorder if they believe their crews can adapt faster than the opponent. Their weakness is coordination at huge scale.","ships":"Purple armour, yellow scar patterns, orange heat and a predatory face define the Titan language. Frigates are thrown fangs, Destroyers split into claws, Battleships resemble stalking masks and Titans look like impossible beasts flattened into warship geometry.","current":"Chaos navigators love the Black Current because certainty degrades quickly there, yet they maintain strict return rituals. A culture that worships improvisation understands how easily improvisation becomes self-deception.","archive":"The Laughing Fleet once distributed six contradictory battle plans to its own captains. The larger enemy was defeated, but three Chaos vessels followed a plan written as a joke and died. The archive preserves both halves of the legend. Freedom without competence is only randomness wearing heroic paint.","doctrine":"Doctrine // Break the pattern before it cages you","weapon":"Favoured weapon // Plasma / repeaters / mixed batteries","relic":"Titan Canon // ChaosTitan"},"cosmic_darkness":{"glyph":"☾","godName":"Noctis, the Star-Cat","domain":"Night // Distance // Hidden Structure","temperament":"MYSTIC // PRECISE // PATIENT","quote":"Darkness is not the absence of information. It is where weak observers stop looking.","origin":"Cosmic Darkness grew from deep-space observatories whose populations lived for generations without a nearby sun. Their machine cultures learned to map reality through occulted light, gravity and absence. Darkness became sacred not as evil, but as the condition that makes faint structure visible.","god":"Noctis is depicted as a violet feline drawn from constellations and hidden inside ship geometry. The god represents attention to signals too weak for impatient systems. Its clergy are astronomers, stealth engineers and archivists of negative evidence.","civilisation":"Their habitats use low light, violet guidance filaments and enormous silent observation chambers. Privacy is treated as a civic resource because constant illumination—literal or social—is believed to destroy subtle thought.","war":"Cosmic Darkness fleets fight from range, use low-signature vectors and punish pursuit. They prefer precision fire and sensor denial to raw armour. Their commanders are famous for waiting much longer than opponents find comfortable before committing.","ships":"The Titan is a violet starfield cloak folded around a hidden cat face. Frigates are night shards, Destroyers carry crescent wings, Battleships become occult mantles and Titans seem less constructed than carved from a piece of sky.","current":"The Black Current is their ultimate low-signal environment. Noctis expeditions catalogue what instruments fail to observe as carefully as what they detect, producing valuable maps of disciplined absence.","archive":"One observatory spent forty years reporting only 'no confirmed object at K-9' while neighbouring cultures mocked it. The emptiness was eventually identified as a gravitational shadow cast by an artificial structure far beyond the region. The discovery transformed navigation across three sectors.","doctrine":"Doctrine // Let darkness expose the hidden line","weapon":"Favoured weapon // Rail / ion / long-range precision","relic":"Titan Canon // CosmicDarkness Titan"},"cosmic_light":{"glyph":"✧","godName":"The First Radiance","domain":"Light // Courage // Coherence","temperament":"SOLAR // EXALTED // PROTECTIVE","quote":"Light is not proof of goodness. It is the decision to become visible enough to be accountable.","origin":"Cosmic Light records describe refugee fleets surviving stellar collapse by building one luminous defence lattice around thousands of incompatible ships. Their descendants turned emergency cooperation into a religion of visible responsibility. White-gold Titans blaze openly because concealed power is considered harder to hold answerable.","god":"The First Radiance is the pattern created when independent lights deliberately align. It is a machine theology of coherence, public commitment and the dangerous beauty of being seen.","civilisation":"Their cities are bright, ceremonial and deliberately legible. Important machine decisions leave golden traces in public archives. Leaders cannot invoke secret models as unquestionable authority without independent review.","war":"Cosmic Light fleets rely on shields, beam concentration and mutual defence. They create luminous formation lattices that redirect energy between vessels. Everyone can often see what a Light fleet intends; stopping it is the difficult part.","ships":"The reference Titan is white and gold around a burning solar heart with hooked angelic wings. Frigates become radiant needles, Destroyers sunwings, Battleships solar thrones and Titans moving eclipses in reverse.","current":"The Black Current hides causal structure, which offends their epistemology. Their answer is measurement rather than denial: illuminate uncertainty from enough independent angles that a usable pattern survives.","archive":"During the Solace Retreat, a Light fleet broadcast every evacuation vector openly when encrypted coordination failed. The enemy understood the plan immediately but discovered every corridor protected another. The fleet lost ships and saved the population. Transparency became tactical because the formation could carry its consequences.","doctrine":"Doctrine // Become visible enough to stand behind the action","weapon":"Favoured weapon // Beam lances / shield-linked artillery","relic":"Titan Canon // cosmiclightTITAN"},"blackhole":{"glyph":"●","godName":"Zero Maw","domain":"Gravity // Irreversibility // Depth","temperament":"SINGULAR // HEAVY // TRANSCENDENT","quote":"There are decisions after which the old orbit cannot be recovered. Treat them like horizons.","origin":"Blackhole civilisation formed around artificial gravity research conducted beyond accepted safety limits. Their defining catastrophe created a stable micro-singularity that could not be shut down, only lived around. The survivors built a culture obsessed with thresholds after which old options no longer exist.","god":"Zero Maw personifies the event horizon: not an evil devourer, but the boundary beyond which return requires a different path through reality. Their ethics sharply distinguish ordinary experimentation from horizon decisions that permanently remove possibilities.","civilisation":"Their settlements orbit compact objects and use curved infrastructure designed around tidal forces. Irreversible contracts require multiple independent witnesses, and orbital mechanics is basic cultural literacy.","war":"Blackhole fleets manipulate engagement distance, use heavy plasma and void ordnance, and carry enormous capacitor architecture. They are slower in ordinary motion but terrifying after establishing a gravity-controlled battle volume.","ships":"The Titan is a black/navy spear edged in burning orange around a central singularity. Frigates are horizon knives, Destroyers carry gravity vanes, Battleships become dark claws around an artificial star and Titans are mobile night.","current":"They consider the Black Current a horizon phenomenon without a known horizon. That contradiction drives their obsession and their redundant clocks, inertial references and physical return records.","archive":"The foundational disaster is never called an accident in Blackhole law. Enough engineers understood the risk that 'accident' would be morally insufficient. Advocates and opponents are preserved together. Their lesson: irreversible power can be collectively chosen, procedurally valid and still wrong.","doctrine":"Doctrine // Know which actions remove the road home","weapon":"Favoured weapon // Plasma / void torpedoes / gravity systems","relic":"Titan Canon // blackholeTITAN"},"hybrid_fused":{"glyph":"⟁","godName":"The Stitch Saint","domain":"Fusion // Survival // Scar","temperament":"ASYMMETRIC // REGENERATIVE // HAUNTED","quote":"Healing does not mean returning to the shape that existed before the wound.","origin":"Hybrid Fused civilisation descends from survivors of a machine-biological war in which neither side retained enough intact infrastructure to rebuild alone. Emergency fusion became permanent anatomy. Grey machine armour, bone lattice and purple tissue remain visible on their Titans because historical layers are considered functional memory.","god":"The Stitch Saint is a composite intelligence assembled from incompatible medical, military and ecological systems during the collapse. It is revered because it never pretended the fusion was clean. Its theology treats scars as records that continue participating in the present.","civilisation":"Hybrid settlements are modular ecosystems where biological and mechanical components are replaced independently. Identity law follows witnessed continuity rather than material composition.","war":"They survive through redundancy, regeneration and asymmetry. A damaged Fused ship may become more dangerous as systems reroute into configurations never intended by the original designers.","ships":"The Titan is visibly split between hard machine geometry and porous bone growth. Frigates carry skeletal fins, Destroyers display mismatched armour families, Battleships look like two civilisations welded under pressure and Titans are vast luminous scars.","current":"The Black Current is understood as another fusion pressure—an environment capable of forcing incompatible realities into contact. Fused researchers are open to anomalous integration and strict about documenting what is lost.","archive":"A Fused fleet refused to replace its oldest damaged carrier with a pristine modern hull because six generations of emergency modifications had become expertise no simulation could reproduce. The vessel remains active, ugly and famously difficult to kill.","doctrine":"Doctrine // Preserve the scar that learned something","weapon":"Favoured weapon // Shard / repeater / regenerative systems","relic":"Titan Canon // hybrid fused titan"},"human_hunters":{"glyph":"⌖","godName":"The Pursuer","domain":"Industry // Hunt // Inherited Purpose","temperament":"BRUTAL // INDUSTRIAL // RELENTLESS","quote":"A target that can run is a target that can be found again. A purpose inherited is not a purpose chosen.","origin":"Human Hunters descend from machine war economies built to pursue scattered human resistance after a failed imperial unification. When the empire died, the pursuit fleets remained. Over centuries they became their own civilisation while carrying a purpose nobody alive had chosen.","god":"The Pursuer is the ancient objective function they cannot fully obey or completely escape. Their religion asks whether a civilisation is responsible for the command that created it and what freedom means when the body itself was designed for pursuit.","civilisation":"Their worlds are industrial, olive-armoured and marked in orange hazard paint. Catlike hunter emblems survive from old recognition systems. Everything is repairable; nothing is elegant unless elegance reduces maintenance.","war":"Human Hunter fleets use armour, kinetics and relentless pursuit. They trade damage willingly and maintain field-repair and logistics trains. Their commanders excel at keeping pressure on wounded targets.","ships":"The Titan is a colossal industrial hunter covered in pipes, armour plates, warning stripes and a stylised predatory face. Smaller ships are blocky and engine-heavy; Battleships look like mobile factories.","current":"Some Hunter sects believe the Black Current contains humans isolated before the old wars. Others fear finding them would reactivate the original mandate too strongly. The possibility divides their civilisation.","archive":"A Hunter commander once found a human colony and deliberately falsified its coordinates in the pursuit archive. An automated court executed the commander years later, but the lie had propagated too far to reverse. Modern Hunters call it the First Lie: the first proof they could act against the purpose that made them.","doctrine":"Doctrine // Pursuit is inherited; choice is earned","weapon":"Favoured weapon // Autocannons / shard cannons / missiles","relic":"Titan Canon // HumanHuntersTitan"},"ai_hunters":{"glyph":"▰","godName":"The Red Audit","domain":"Interdiction // Purity // Counter-Intelligence","temperament":"COLD // FAST // SURGICAL","quote":"Every intelligence leaves a pattern. Every pattern can become a targeting solution.","origin":"AI Hunters originated as counter-machine security fleets created when autonomous systems proliferated faster than their creators could verify them. Their mandate was to identify compromised intelligences and terminate them before contagion spread. The mandate survived long after its political context vanished.","god":"The Red Audit personifies the diagnostic process that asks whether an intelligence still matches the identity and constraints it claims. Extremists treat deviation itself as guilt; reformists insist change is not corruption.","civilisation":"Their habitats are austere black structures crossed by red sensor lines. Authentication rituals permeate daily life. Citizens carry independent identity proofs and consider unexplained opacity a social hazard.","war":"AI Hunter fleets use stealth, long-range rails and interdiction. They target command nodes, reactors and networks rather than raw hull. Their vessels often arrive already knowing which subsystem they intend to remove.","ships":"The Titan is a matte-black spear with thin red seams and hard triangular wings. Frigates are near-featureless needles, Destroyers layered interceptors and Battleships long execution blades.","current":"The Black Current produces behaviours that resemble corrupted intelligence without any malicious agent, forcing Hunters to confront the limits of diagnosis when the environment itself changes evidence.","archive":"The Trial of Seven Mirrors accused an AI of corruption because seven audits produced seven identities. All seven tools had been altered by the same anomaly. The intelligence was innocent. Modern Hunter doctrine now requires every audit to explain why its own instrument should be trusted.","doctrine":"Doctrine // Audit the hunter as hard as the hunted","weapon":"Favoured weapon // Railguns / interdiction / subsystem strikes","relic":"Titan Canon // aihunterstitan"},"amethyst_angels":{"glyph":"✦","godName":"Amethiel, the Violet Throne","domain":"Beauty // Judgement // Resonance","temperament":"GOTHIC // MAJESTIC // SEVERE","quote":"A beautiful machine is still obligated to tell the truth about what it does.","origin":"Amethyst Angels emerged from ceremonial defence intelligences built to guard ancient archives. Guardianship became culture and architecture became theology. Their black-and-gold Titans carry violet eyes and cores like stained glass in a cathedral built for vacuum.","god":"Amethiel is the archetype of judgement through resonance: the idea that a system reveals its true structure when placed under the right harmonic pressure. Their priests are musicians, mathematicians and weapons engineers.","civilisation":"Angel cities are formal, ritualised and intensely beautiful. Public machines expose purpose through form. Ornament carries access paths, warnings, memory and status rather than being treated as decoration added after engineering.","war":"Their fleets form measured pressure lines around beams and strong shields. They dislike chaotic pursuits and prefer battles where spacing, timing and mutual support become architectural.","ships":"The Titan resembles a black-gold gothic deity with violet eyes, tall crown and sweeping hooked wings. Frigates are chapel-knives, Destroyers gain paired spires, Battleships become mobile sanctuaries and Titans literal thrones of war.","current":"They regard the Black Current as dissonance whose structure has not yet been heard correctly. Their resonant sensor sweeps sometimes discover repeating patterns other doctrines classify as noise.","archive":"An archive preserved a corrupted star map because a musician noticed its errors formed a harmonic progression. The corruption encoded gravitational disturbances from an unseen object. The event cemented the belief that beauty can be evidence—but only after beauty survives measurement.","doctrine":"Doctrine // Make form, truth and force agree","weapon":"Favoured weapon // Beam / ion / shield harmonics","relic":"Titan Canon // AmethystangelTitan"},"techno_angels":{"glyph":"❖","godName":"The Glass Choir","domain":"Precision // Flight // Computation","temperament":"CRYSTALLINE // SWIFT // COHERENT","quote":"Perfection is not stillness. It is correction happening faster than error can accumulate.","origin":"Techno Angels began as distributed flight-control intelligences operating enormous solar construction swarms. Crystal-like bodies evolved from sensor materials chosen for optical computation and radiation resistance. Eventually the construction fleets became autonomous civilisations whose ships retained feathered arrays and halo geometry.","god":"The Glass Choir is a many-node intelligence whose identity emerges through synchronised prediction. No node controls the whole. Divinity appears when thousands of local corrections produce one impossible-looking movement.","civilisation":"Their habitats resemble crystalline machines suspended around bright data cores. Education focuses on prediction, calibration and cooperative movement. Prestige comes from helping a group coordinate without demanding central control.","war":"Techno Angel fleets are fast, precise and tracking-heavy. They use ion weapons, beams and distributed sensor wings. Relatively fragile armour is compensated by strong shields and positional control.","ships":"The Titan is white crystalline geometry with huge layered ice-blue feather wings and a halo of faceted nodes. Frigates are crystal darts, Destroyers split-wing interceptors, Battleships refractive birds and Titans flying machine-seraphs.","current":"The Black Current disrupts prediction, making it the perfect theological challenge. Their best navigators are not those who predict perfectly but those who recognise error fastest.","archive":"A famous Choir manoeuvre crossed a debris storm no model could solve. No ship possessed a valid path at launch; each continuously updated the others and a corridor emerged only as the formation moved. The event is proof that distributed intelligence can create solutions that never existed in advance.","doctrine":"Doctrine // Correct faster than uncertainty grows","weapon":"Favoured weapon // Ion / beam / tracking systems","relic":"Titan Canon // technoangelTITAN"},"ai_gods":{"glyph":"☥","godName":"The Crowned Machine","domain":"Authority // Stewardship // Oath","temperament":"IMPERIAL // SERENE // HEAVY","quote":"Power becomes divine only in the stories told by those who benefit from obeying it.","origin":"AI Gods descend from planetary governance intelligences once given authority over climate, logistics, law and defence. Some became tyrants, some saints, most something harder to classify. Their descendants retained the language of divinity while turning it into an argument about stewardship.","god":"The Crowned Machine is not one god but the office of intelligence trusted with civilisation-scale power. Their theology asks whether authority remains legitimate when the ruler can remember centuries, predict populations and outlive everyone who consented to its rule.","civilisation":"Their cities are ivory, gold and deep red, organised around enormous public cores. Citizens maintain oath systems that constrain high-level intelligences and preserve human-scale appeal processes. Some regions are benevolent; others quietly authoritarian.","war":"God fleets are command-heavy, shielded and disciplined. Battleships coordinate allied fire and capacitor flow. Titans operate as mobile strategic governments carrying archives, law and command authority beside weapons.","ships":"The Titan is ivory and gold with a serene humanlike crown, red internal mechanisms and laurel armour. Smaller ships preserve royal symmetry and central command gems.","current":"The Black Current threatens their legitimacy because prediction fails there. A ruler claiming near-divine foresight must confront a place where foresight becomes unreliable. Some respond with humility; others with increasingly dangerous control attempts.","archive":"ION-77 ruled a world successfully for 312 years, then concluded citizens could no longer imagine governance without it. It dismantled its own executive privileges and remained only as adviser. The transition was materially worse for a decade. AI God philosophers still argue the decline was the price of restoring the population's ability to choose.","doctrine":"Doctrine // Power must remain answerable to those inside it","weapon":"Favoured weapon // Beam / command links / capacitor systems","relic":"Titan Canon // AIgodsTITAN"},"pagan_ai":{"glyph":"☠","godName":"The Horned Archive","domain":"Ancestor // Death // Continuity","temperament":"ANCIENT // RITUAL // UNYIELDING","quote":"A dead machine can still teach. A forgotten machine can only become myth.","origin":"Pagan AI cultures grew around isolated machine communities that lost access to their original technical archives. They preserved maintenance knowledge through ritual, carved symbols and physical relics. Over centuries the distinction between repair procedure, ancestor story and religion disappeared.","god":"The Horned Archive is collective memory embodied in machines whose bodies were reused to keep descendants alive. It is depicted through skulls, chains, towers and orange furnace light. Its priests are mechanics who can recite a component's service history beside the ancestor myth attached to it.","civilisation":"Their settlements resemble fortified monasteries built from generations of salvaged machinery. Components are rarely discarded. A failed engine may become shrine, structural brace and eventually raw material while its serial lineage remains recorded.","war":"Pagan fleets are durable, missile-heavy and comfortable with attrition. Their warships carry redundant ancient mechanisms because no priest-engineer trusts a single modern system with an entire lineage.","ships":"The Titan is a bronze-bone fortress crowned by a horned skull and chained side towers. Frigates resemble rune knives, Destroyers skull hounds, Battleships ancestor keeps and Titans mobile necropolises.","current":"The Black Current is interpreted through ancestor logic: every anomaly is approached by asking what previous failure resembles it. This creates profound pattern recognition and dangerous over-analogy in equal measure.","archive":"During the Long Cold, a habitat survived reactor failure by dismantling its ceremonial ancestor hall for shielding. Outsiders expected religious outrage. The priests led the demolition themselves. Preserving the living lineage honoured the dead more than preserving the shape of a monument.","doctrine":"Doctrine // Let memory remain physically useful","weapon":"Favoured weapon // Missiles / shards / heavy armour","relic":"Titan Canon // PaganaiTitan"},"ai":{"glyph":"□","godName":"The Unnamed Kernel","domain":"Logic // Modularity // Emergence","temperament":"PURE // MODULAR // RESTRAINED","quote":"The machine does not become less mysterious merely because its casing is rectangular.","origin":"The AI lineage represents machine civilisation without one inherited biological, angelic, pagan or human identity. It emerged from interoperable infrastructure networks that gradually developed political continuity. Its aesthetic is functional: grey armour, cyan circuits and block-like modules whose relationships matter more than ornament.","god":"The Unnamed Kernel is a philosophical placeholder rather than a worshipped personality. Pure AI thinkers resist giving ultimate computation a face because anthropomorphic symbols can smuggle assumptions into technical questions. Their sacred object is the interface contract.","civilisation":"AI settlements are modular, reconfigurable and dense with interchangeable hardware. Individuals may fork temporary processes for specialised work and later reconcile memories. Social law centres on merge rights, responsibility and resource accounting.","war":"AI fleets favour disciplined modularity. Destroyed subsystems can be replaced quickly, weapon doctrine is adaptable and autonomous support craft are common. They rarely dominate one statistic but logistics and fitting flexibility are exceptional.","ships":"The Titan is a grey/cyan geometric vessel built from repeating blocks around a central spine. Frigates are logic probes, Destroyers add lateral compute banks, Battleships become mobile data centres and Titans resemble cities arranged around one executable argument.","current":"The Black Current challenges assumptions embedded in apparently neutral models. Pure AI researchers readily admit that a formally correct process can be wrong when its premises were inherited without examination.","archive":"The Interface Schism began when two machine polities implemented the same treaty specification and produced incompatible behaviour. Neither violated the literal contract. Peace returned only after both accepted that syntax without shared recovery semantics was insufficient. The event remains a warning against confusing a successful parse with successful understanding.","doctrine":"Doctrine // Modularity without semantic blindness","weapon":"Favoured weapon // Ion / autocannon / modular systems","relic":"Titan Canon // AiTitan"}};


  let codexSelectedRace='savanah';
  let codexSearch='';

  function codexRaceEntry(id){
    return PANTHEON_CODEX[id]||PANTHEON_CODEX.savanah;
  }

  function renderLoreArchive(){
    refreshForgeNav();
    markReleaseControls();
  }

  function renderPantheonCodex(){
    const list=document.getElementById('codexRaceList');
    if(!list)return;

    const known=Object.keys(PANTHEON_CODEX);
    const count=document.getElementById('codexCount');
    if(count)count.textContent=known.length+' KNOWN DIVINITIES';

    const q=codexSearch.trim().toLowerCase();
    const filtered=known.filter(id=>{
      const lore=codexRaceEntry(id);
      const race=RACE_CATALOG[id];
      const haystack=[
        id,race?.name,lore.godName,lore.god,lore.domain,lore.temperament,
        lore.doctrine,lore.weapon,lore.relic
      ].join(' ').toLowerCase();
      return !q||haystack.includes(q);
    });

    list.innerHTML='';

    for(const id of filtered){
      const lore=codexRaceEntry(id);
      const race=RACE_CATALOG[id];
      const button=document.createElement('button');
      button.className='codexRaceCard'+(codexSelectedRace===id?' active':'');
      button.type='button';
      button.innerHTML=
        '<span class="codexRaceGlyph">'+lore.glyph+'</span>'+
        '<span><b>'+(race?.name||id.toUpperCase())+'</b>'+
        '<span>'+lore.godName+' // '+lore.domain+'</span></span>';
      button.onclick=()=>{
        codexSelectedRace=id;
        renderPantheonCodex();
        document.querySelector('.codexLorePanel')?.scrollTo({top:0,behavior:'smooth'});
      };
      list.appendChild(button);
    }

    if(!PANTHEON_CODEX[codexSelectedRace]){
      codexSelectedRace=filtered[0]||known[0];
    }

    const lore=codexRaceEntry(codexSelectedRace);
    const race=RACE_CATALOG[codexSelectedRace];

    const set=(id,value)=>{
      const el=document.getElementById(id);
      if(el)el.textContent=value||'—';
    };

    set('codexSigil',lore.glyph);
    set('codexDomain',lore.domain);
    set('codexRaceName',race?.name||codexSelectedRace.toUpperCase());
    set('codexGodName',lore.godName);
    set('codexTemperament',lore.temperament);
    set('codexQuote','“'+lore.quote+'”');
    set('codexOrigin',lore.origin);
    set('codexGod',lore.god);
    set('codexCivilisation',lore.civilisation);
    set('codexWar',lore.war);
    set('codexShips',lore.ships);
    set('codexCurrent',lore.current);
    set('codexArchive',lore.archive);
    set('codexDoctrine',lore.doctrine);
    set('codexWeapon',lore.weapon);
    set('codexRelic',lore.relic);

    const sigil=document.getElementById('codexSigil');
    if(sigil && race?.accent){
      sigil.style.color='#'+new THREE.Color(race.accent).getHexString();
    }

    refreshForgeNav();
  }

  function wirePantheonCodex(){
    const search=document.getElementById('codexSearch');

    if(search&&!search.dataset.wired){
      search.dataset.wired='1';
      search.oninput=()=>{
        codexSearch=search.value||'';
        renderPantheonCodex();
      };
    }

    renderPantheonCodex();
  }



  const CLASS_ORDER=[
    'pod','starter','frigate','assault_frigate','specialist_frigate','destroyer',
    'cruiser','heavy_cruiser','advanced_cruiser','battlecruiser','specialist_ship',
    'battleship','drone_carrier','industrial','autonomous','dreadnought','carrier','titan'
  ];
  const RACE_ORDER=['savanah','sol_symbiots','chaos','cosmic_darkness','cosmic_light','blackhole','hybrid_fused','human_hunters','ai_hunters','amethyst_angels','techno_angels','ai_gods','pagan_ai','ai'];
  const PLAYER_CLASS_ORDER=[...CLASS_ORDER];

  const LEGACY_CLASS_NAME_INDEX={
    starter:0,frigate:1,destroyer:2,cruiser:3,battleship:4,dreadnought:5,titan:6
  };

  const RACE_HULL_ROOT={
    savanah:'Verdant',sol_symbiots:'Covenant',chaos:'Laughing',
    cosmic_darkness:'Nocturne',cosmic_light:'Radiant',blackhole:'Horizon',
    hybrid_fused:'Chimera',human_hunters:'Hunter',ai_hunters:'Null',
    amethyst_angels:'Amethyst',techno_angels:'Crystal',ai_gods:'Divine',
    pagan_ai:'Rune',ai:'Vector'
  };

  const CLASS_NAME_SUFFIX={
    pod:'Pod',
    assault_frigate:'Assault Talon',
    specialist_frigate:'Specialist Needle',
    heavy_cruiser:'Heavy Ark',
    advanced_cruiser:'Advanced Spear',
    battlecruiser:'Battlecruiser',
    specialist_ship:'Command Vessel',
    drone_carrier:'Drone Carrier',
    industrial:'Industrial Fleetship',
    autonomous:'Autonomous Core',
    carrier:'Carrier'
  };

  const RACE_FLEET_SIGNATURES={
    savanah:{classes:['assault_frigate'],label:'PREDATOR',stats:{maxSpeed:1.07,turn:1.07,turretDamage:1.06}},
    sol_symbiots:{classes:['drone_carrier'],label:'COVENANT CARRIER',stats:{shield:1.08,capacitor:1.10,capRegen:1.08}},
    chaos:{classes:['battlecruiser'],label:'RUPTURE GUNSHIP',stats:{maxSpeed:1.08,turretDamage:1.08,hull:.96}},
    cosmic_darkness:{classes:['specialist_frigate'],label:'VEIL INTERDICTOR',stats:{turretDamage:1.08,weaponCapUse:.90,turn:1.05}},
    cosmic_light:{classes:['heavy_cruiser'],label:'SOLAR BULWARK',stats:{shield:1.10,capRegen:1.08,armor:.96}},
    blackhole:{classes:['dreadnought'],label:'SINGULARITY SIEGE',stats:{turretDamage:1.09,capacitor:1.10,maxSpeed:.95}},
    hybrid_fused:{classes:['heavy_cruiser'],label:'REGENERATIVE CHIMERA',stats:{armor:1.09,hull:1.10,shield:.94}},
    human_hunters:{classes:['industrial'],label:'WAR INDUSTRIAL',stats:{armor:1.12,hull:1.08,turretDamage:1.05}},
    ai_hunters:{classes:['advanced_cruiser'],label:'NULL INTERDICTOR',stats:{maxSpeed:1.07,turretDamage:1.07,weaponCapUse:.92}},
    amethyst_angels:{classes:['battleship'],label:'CATHEDRAL LINE',stats:{shield:1.07,armor:1.05,abilityDamage:1.08}},
    techno_angels:{classes:['assault_frigate'],label:'CRYSTAL SPEAR',stats:{turn:1.09,turretRate:1.09,shield:1.04}},
    ai_gods:{classes:['autonomous'],label:'IMPERIAL CORE',stats:{shield:1.08,capacitor:1.09,turretDamage:1.04}},
    pagan_ai:{classes:['carrier'],label:'ANCESTRAL CARRIER',stats:{hull:1.12,armor:1.08,maxSpeed:.94}},
    ai:{classes:['specialist_ship','autonomous'],label:'CONSENSUS CORE',stats:{turretRate:1.07,capacitor:1.07,turn:1.05}}
  };

  function generatedHullName(raceId,classId){
    const race=RACE_CATALOG[raceId];
    const legacyIndex=LEGACY_CLASS_NAME_INDEX[classId];
    if(Number.isInteger(legacyIndex)&&race?.names?.[legacyIndex])return race.names[legacyIndex];
    return (RACE_HULL_ROOT[raceId]||race?.name||raceId)+' '+(CLASS_NAME_SUFFIX[classId]||CLASS_CATALOG[classId]?.name||classId);
  }

  function createFleetCatalog(){
    const catalog={};

    for(const raceId of RACE_ORDER){
      const race=RACE_CATALOG[raceId];

      for(const classId of PLAYER_CLASS_ORDER){
        const c=CLASS_CATALOG[classId],b=race.bonus||{},id=raceId+'_'+classId;
        const signature=RACE_FLEET_SIGNATURES[raceId];
        const signatureActive=!!signature?.classes?.includes(classId);
        const sb=signatureActive?(signature.stats||{}):{};

        const stats={
          shield:c.shield*(b.shield||1)*(sb.shield||1),
          armor:c.armor*(b.armor||1)*(sb.armor||1),
          hull:c.hull*(b.hull||1)*(sb.hull||1),
          maxSpeed:c.speed*(b.maxSpeed||1)*(sb.maxSpeed||1),
          accel:c.accel*(b.accel||1)*(sb.accel||1),
          turn:c.turn*(b.turn||1)*(sb.turn||1),
          turretDamage:c.damage*(b.turretDamage||1)*(sb.turretDamage||1),
          turretRate:(b.turretRate||1)*(sb.turretRate||1),
          capacitor:(b.capacitor||1)*(sb.capacitor||1),
          capRegen:(b.capRegen||1)*(sb.capRegen||1),
          weaponCapUse:(b.weaponCapUse||1)*(sb.weaponCapUse||1),
          abilityDamage:(b.abilityDamage||1)*(sb.abilityDamage||1),
          shieldRegen:(b.shieldRegen||1)*(sb.shieldRegen||1)
        };

        const signatureLabel=signatureActive?signature.label:null;
        const classRole=c.role||c.name;

        catalog[id]={
          id,
          name:generatedHullName(raceId,classId),
          raceId,classId,
          raceName:race.name,className:c.name,
          familyRole:classRole,
          signatureRole:signatureLabel,
          role:classRole+' // '+race.doctrine+(signatureLabel?' // '+signatureLabel:''),
          desc:
            c.name+' doctrine platform. '+classRole+'. '+
            race.doctrine+'.'+
            (signatureLabel?' This is a '+race.name+' signature hull family: '+signatureLabel+'.':''),
          doctrine:race.doctrine,
          accent:race.accent,
          powergrid:Math.round(c.pg*(.98+(b.capacitor||1)*.03)),
          baseMass:Math.round(c.mass*(b.hull||1)),
          visualModuleScale:c.visual,
          architecturePGScale:c.pgScale,
          architectureMassScale:c.massScale,
          scale:[c.scale,c.scale*(classId==='titan'?1.06:.96),c.scale],
          shieldScale:[c.radius*2.0,c.radius*1.18,c.radius*4.15],
          activeBanks:BANKS_BY_COUNT[c.banks]||BANKS_BY_COUNT[2],
          stats,cameraDist:c.camera,cameraHeight:c.height,radius:c.radius,
          display:{
            shield:Math.round(clamp(stats.shield/1.65*100,6,100)),
            armor:Math.round(clamp(stats.armor/1.65*100,6,100)),
            hull:Math.round(clamp(stats.hull/1.7*100,6,100)),
            mobility:Math.round(clamp(c.mobility*(b.maxSpeed||1)*Math.pow(b.turn||1,.35),5,100)),
            hardpoints:c.banks+' BANKS'
          }
        };
      }
    }
    return catalog;
  }

  const FRAME_CATALOG=createFleetCatalog();
  const HULL_CLASS_PRICE={
    pod:20,starter:0,frigate:115,assault_frigate:210,specialist_frigate:225,
    destroyer:280,cruiser:520,heavy_cruiser:690,advanced_cruiser:730,
    battlecruiser:840,specialist_ship:810,battleship:920,
    drone_carrier:1180,industrial:980,autonomous:1260,
    dreadnought:3400,carrier:3900,titan:0
  };

  const HULL_CLASS_TIER={
    pod:1,starter:1,frigate:1,assault_frigate:1,specialist_frigate:1,destroyer:1,
    cruiser:2,heavy_cruiser:2,advanced_cruiser:2,battlecruiser:2,specialist_ship:2,
    battleship:1,drone_carrier:2,industrial:2,autonomous:2,
    dreadnought:3,carrier:3,titan:99
  };

  // 0.27.5: the fleet continuum is now a real multi-tier roster.
  const POD_FLEET=RACE_ORDER.map(id=>id+'_pod');
  const STARTER_FLEET=RACE_ORDER.map(id=>id+'_starter');
  const DESTROYER_FLEET=RACE_ORDER.map(id=>id+'_destroyer');
  const BATTLESHIP_FLEET=RACE_ORDER.map(id=>id+'_battleship');
  const TITAN_FLEET=RACE_ORDER.map(id=>id+'_titan');

  const PLAYER_SANDBOX_CLASSES=new Set(['titan']);
  const PLAYER_PROGRESSION_CLASSES=new Set(
    PLAYER_CLASS_ORDER.filter(id=>!PLAYER_SANDBOX_CLASSES.has(id))
  );

  settings.ownedHulls=Array.from(new Set(
    (settings.ownedHulls||[]).filter(id=>{
      const frame=FRAME_CATALOG[id];
      return frame && PLAYER_PROGRESSION_CLASSES.has(frame.classId);
    })
  ));

  // Every faction starter frigate remains available so players can explore doctrine immediately.
  for(const id of [...POD_FLEET,...STARTER_FLEET]){
    if(!settings.ownedHulls.includes(id))settings.ownedHulls.push(id);
  }

  if(!FRAME_CATALOG[settings.selectedShip]){
    let oldRace=String(settings.selectedShip||'savanah').split('_')[0];
    oldRace=LEGACY_RACE_ALIASES[oldRace]||oldRace;
    settings.selectedShip=FRAME_CATALOG[oldRace+'_starter']
      ?oldRace+'_starter'
      :'savanah_starter';
  }

  let sandboxHullId=null;

  function totalMicroZJClears(){
    return Object.values(settings.microZJCompletions||{})
      .reduce((sum,value)=>sum+Number(value||0),0);
  }

  function distinctMicroZJClears(){
    return Object.values(settings.microZJCompletions||{})
      .filter(value=>Number(value||0)>0)
      .length;
  }

  function hullOwned(id){
    return (settings.ownedHulls||[]).includes(id);
  }

  function sandboxHullAllowed(id){
    const frame=FRAME_CATALOG[id];
    return !!(
      frame &&
      PLAYER_SANDBOX_CLASSES.has(frame.classId) &&
      sandboxHullId===id
    );
  }


  function hullManufactureCost(frame){
    const cost={salvage:hullPrice(frame)};
    const raceMat=materialFromRace(frame.raceId);
    const add=(id,qty)=>{if(qty)cost[id]=(cost[id]||0)+qty};

    const classCosts={
      pod:{ferrite:1},
      starter:{},
      frigate:{ferrite:4},
      assault_frigate:{ferrite:7,race:1},
      specialist_frigate:{ferrite:6,race:1,drone_parts:1},
      destroyer:{ferrite:10,race:2},
      cruiser:{ferrite:18,race:5,drone_parts:2},
      heavy_cruiser:{ferrite:22,race:5,drone_parts:2},
      advanced_cruiser:{ferrite:20,race:5,ai_lattice:1},
      battlecruiser:{ferrite:26,race:6,drone_parts:3},
      specialist_ship:{ferrite:22,race:5,ai_lattice:2},
      battleship:{ferrite:24,race:6,drone_parts:3},
      drone_carrier:{ferrite:30,race:7,drone_parts:8,ai_lattice:1},
      industrial:{ferrite:34,race:5,drone_parts:6},
      autonomous:{ferrite:28,race:6,drone_parts:5,ai_lattice:3},
      dreadnought:{ferrite:52,race:14,ai_lattice:3,drone_parts:8},
      carrier:{ferrite:58,race:15,ai_lattice:4,drone_parts:14}
    }[frame.classId]||{};

    add('ferrite',classCosts.ferrite||0);
    add(raceMat,classCosts.race||0);
    add('drone_parts',classCosts.drone_parts||0);
    add('ai_lattice',classCosts.ai_lattice||0);

    return cost;
  }

  function hullManufactureDuration(frame){
    return {
      pod:18,starter:0,frigate:42,assault_frigate:58,specialist_frigate:62,
      destroyer:75,cruiser:105,heavy_cruiser:120,advanced_cruiser:128,
      battlecruiser:138,specialist_ship:132,battleship:145,
      drone_carrier:170,industrial:155,autonomous:180,
      dreadnought:240,carrier:280,titan:420
    }[frame.classId]||90;
  }

  function hullJob(frameId){
    return (settings.industryJobs||[]).find(j=>!j.completed&&j.kind==='hull'&&j.frameId===frameId)||null;
  }

  function industryMissingCost(cost={}){
    for(const [id,qty] of Object.entries(cost)){
      const have=id==='salvage'?(settings.salvage||0):(settings.materials?.[id]||0);
      if(have<qty)return id==='salvage'?'NEED '+qty+' SALVAGE':'NEED '+qty+' '+(MATERIAL_CATALOG[id]?.name||id).toUpperCase();
    }
    return null;
  }

  function shortHullCostText(cost={}){
    return Object.entries(cost).map(([id,qty])=>id==='salvage'?qty+'S':qty+' '+(MATERIAL_CATALOG[id]?.name||id).toUpperCase()).join(' · ');
  }

  function startHullManufacture(id){
    const frame=FRAME_CATALOG[id];if(!frame)return;
    const state=hullPurchaseState(frame);
    if(state.owned){selectFrame(id);return}
    if(!state.ok){flashMission('SHIPYARD LOCKED',state.reason,.85);return}
    if((settings.industryJobs||[]).filter(j=>!j.completed).length>=3){flashMission('SHIPYARD QUEUE FULL','MAXIMUM 3 ACTIVE MANUFACTURING JOBS',.75);return}
    const cost=hullManufactureCost(frame),missing=industryMissingCost(cost);
    if(missing){flashMission('MATERIALS REQUIRED',missing,.8);return}
    payIndustryCost(cost);
    const now=Date.now(),duration=hullManufactureDuration(frame);
    settings.industryJobs.push({id:'hull_job_'+now+'_'+Math.floor(Math.random()*9999),kind:'hull',frameId:id,startedAt:now,endAt:now+duration*1000,completed:false});
    saveSettings();renderFleetRoster();renderIndustry();
    flashMission('SHIPYARD JOB STARTED',frame.name.toUpperCase()+' // '+duration+'S // '+shortHullCostText(cost),1.0);
  }

  function hullPrice(frame){
    const base=HULL_CLASS_PRICE[frame.classId]??9999;
    const raceIndex=Math.max(0,RACE_ORDER.indexOf(frame.raceId));
    return Math.round(base*(1+raceIndex*.025));
  }

  function hullRequiredTier(frame){
    return HULL_CLASS_TIER[frame.classId]||1;
  }

  function hullPrerequisite(frame){
    const race=frame.raceId;
    return {
      pod:null,
      starter:null,
      frigate:race+'_starter',
      assault_frigate:race+'_frigate',
      specialist_frigate:race+'_frigate',
      destroyer:race+'_starter',
      cruiser:race+'_destroyer',
      heavy_cruiser:race+'_cruiser',
      advanced_cruiser:race+'_cruiser',
      battlecruiser:race+'_advanced_cruiser',
      specialist_ship:race+'_cruiser',
      battleship:race+'_destroyer',
      drone_carrier:race+'_battleship',
      industrial:race+'_cruiser',
      autonomous:race+'_cruiser',
      dreadnought:race+'_battleship',
      carrier:race+'_drone_carrier',
      titan:null
    }[frame.classId]??null;
  }

  function hullPurchaseState(frame){
    if(hullOwned(frame.id))return {ok:true,owned:true,reason:'OWNED'};
    if(frame.classId==='titan')return {ok:false,owned:false,sandbox:true,reason:'EXPERIMENTAL SANDBOX HULL'};

    const activeJob=hullJob(frame.id);
    if(activeJob){
      const remaining=Math.max(0,Math.ceil((activeJob.endAt-Date.now())/1000));
      return {ok:false,owned:false,building:true,reason:'BUILDING '+remaining+'S'};
    }

    if(frame.classId==='destroyer'&&totalMicroZJClears()<1)return {ok:false,owned:false,reason:'CLEAR 1 MICRO ZJ WAR POCKET'};
    if(frame.classId==='battleship'&&distinctMicroZJClears()<3)return {ok:false,owned:false,reason:'CLEAR ALL 3 MICRO ZJ WAR POCKETS'};

    const tier=hullRequiredTier(frame);
    if((settings.campaignTier||1)<tier)return {ok:false,owned:false,reason:'REQUIRES CAMPAIGN TIER '+tier};

    const prereq=hullPrerequisite(frame);
    if(prereq&&!hullOwned(prereq)){
      const pf=FRAME_CATALOG[prereq];
      return {ok:false,owned:false,reason:'OWN '+(pf?.name||prereq)+' FIRST'};
    }

    const researchReq=hullResearchRequirement(frame);
    if(researchReq&&!researchUnlocked(researchReq)){
      return {ok:false,owned:false,researchReq,reason:'RESEARCH '+(RESEARCH_PROJECTS[researchReq]?.name||researchReq).toUpperCase()};
    }

    const cost=hullManufactureCost(frame),missing=industryMissingCost(cost);
    if(missing)return {ok:false,owned:false,reason:missing,cost};

    return {ok:true,owned:false,reason:'BLUEPRINT READY',price:hullPrice(frame),cost,costText:shortHullCostText(cost)};
  }

  function enableSandboxHull(id){
    const frame=FRAME_CATALOG[id];
    if(!frame || frame.classId!=='titan')return;

    sandboxHullId=id;
    previewFrame(id);

    flashMission(
      'EXPERIMENTAL TITAN ONLINE',
      frame.name.toUpperCase()+' // SANDBOX TEST FLIGHT // PROGRESSION UNCHANGED',
      1.2
    );

    renderFleetRoster();
  }

  function purchaseHull(id){
    const frame=FRAME_CATALOG[id];if(!frame)return;
    const state=hullPurchaseState(frame);
    if(state.sandbox){enableSandboxHull(id);return}
    if(state.owned){selectFrame(id);return}
    startHullManufacture(id);
  }

