  const PORTAL_LINKS=[
    {
      id:'naraka_erebos',
      a:{sector:'naraka',pos:WORLD.gate,name:'ANCIENT GATE'},
      b:{sector:'erebos',pos:EREBOS.gate,name:'RETURN GATE'},
